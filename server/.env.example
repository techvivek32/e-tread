# NOVA E*TRADE proxy — copy to .env on the VPS and fill in. NEVER commit the real .env.
# chmod 600 .env

# ---- E*TRADE app credentials -------------------------------------------------------
# From developer.etrade.com. Sandbox keys arrive in hours; production keys need the signed
# API Developer Licensing Agreement emailed to E*TRADE first.
# These are NOT the account username/password — the API never uses those.
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=

# sandbox => https://apisb.etrade.com   |   production => https://api.etrade.com
ETRADE_ENV=sandbox

# Optional: pin one account. Leave blank to auto-adopt the first ACTIVE account after login
# (the multi-account model from 01-ARCHITECTURE.md).
ETRADE_ACCOUNT_ID_KEY=

# ---- Token encryption --------------------------------------------------------------
# Encrypts the daily access token at rest (AES-256-GCM). Any long random string; >= 16 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ETRADE_TOKEN_KEY=

# ---- Server ------------------------------------------------------------------------
PORT=8005
STATE_DIR=/var/www/nova-etrade/server/.state

# Browser origins allowed to call this proxy (comma separated, no trailing slash).
ALLOWED_ORIGINS=https://your-app-domain.example.com

# ---- Caller authorisation (FAIL CLOSED) --------------------------------------------
# Only these Supabase-authenticated emails may place orders through this proxy.
# Empty => the process refuses to start.
ALLOWED_EMAILS=

# Used to verify the caller's Supabase JWT. Anon key is fine — it only reads /auth/v1/user.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Tuning ------------------------------------------------------------------------
# E*TRADE publishes no rate limits. Start conservative, raise after measuring on day 1.
ETRADE_RPS=4
ETRADE_CONCURRENCY=4

# Token goes INACTIVE after 2h of silence — renew well inside that window.
RENEW_INTERVAL_MS=5400000

# How often the synthetic bracket engine checks price and the order book.
OCO_INTERVAL_MS=5000
